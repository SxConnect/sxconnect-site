    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'SxConnect CMS' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', sans-serif; background: #020617; color: white; }
      .gradient { background: linear-gradient(135deg, #0f172a, #1e293b, #2563eb); }
      html { scroll-behavior: smooth; }
      .prose h1, .prose h2, .prose h3 { color: white; }
