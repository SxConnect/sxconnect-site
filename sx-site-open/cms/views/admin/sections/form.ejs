<%- include('../layout') %>
<h1 class="text-3xl font-bold mb-8"><%= section ? 'Editar' : 'Nova' %> Secao</h1>
<form action="<%= section ? '/admin/sections/' + section.id + '?_method=PUT' : '/admin/sections' %>" method="POST" class="space-y-6 max-w-4xl">
    <div class="grid grid-cols-2 gap-6">
        <div><label class="block text-sm text-slate-400 mb-2">Tipo</label><select name="type" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white"><option value="hero" <%= section && section.type === 'hero' ? 'selected' : '' %>>Hero</option><option value="text" <%= section && section.type === 'text' ? 'selected' : '' %>>Texto</option><option value="cards" <%= section && section.type === 'cards' ? 'selected' : '' %>>Cards</option><option value="grid" <%= section && section.type === 'grid' ? 'selected' : '' %>>Grid</option><option value="plans" <%= section && section.type === 'plans' ? 'selected' : '' %>>Planos</option><option value="news" <%= section && section.type === 'news' ? 'selected' : '' %>>Noticias</option><option value="cta" <%= section && section.type === 'cta' ? 'selected' : '' %>>CTA</option></select></div>
        <div><label class="block text-sm text-slate-400 mb-2">Ordem</label><input type="number" name="section_order" value="<%= section ? section.section_order : 0 %>" min="0" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    </div>
    <div><label class="block text-sm text-slate-400 mb-2">Titulo</label><input type="text" name="title" value="<%= section ? section.title : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    <div><label class="block text-sm text-slate-400 mb-2">Subtitulo</label><input type="text" name="subtitle" value="<%= section ? section.subtitle : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    <div><label class="block text-sm text-slate-400 mb-2">Conteudo (HTML)</label><textarea name="content" rows="6" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 font-mono text-sm focus:outline-none focus:border-blue-500 text-white"><%= section ? section.content : '' %></textarea></div>
    <div><label class="block text-sm text-slate-400 mb-2">Imagem (URL)</label><input type="text" name="image" value="<%= section ? section.image || '' : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    <div><label class="block text-sm text-slate-400 mb-2">Dados Extras (JSON)</label><textarea name="extra_str" rows="6" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 font-mono text-sm focus:outline-none focus:border-blue-500 text-white"><%= section && section.extra ? JSON.stringify(section.extra, null, 2) : '' %></textarea></div>
    <label class="flex items-center gap-3"><input type="checkbox" name="visible" value="1" <%= !section || section.visible ? 'checked' : '' %> class="w-5 h-5" /> <span>Visivel no site</span></label>
    <div class="flex gap-4">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 px-6 py-3 rounded-lg font-semibold transition">Salvar</button>
        <a href="/admin/sections" class="border border-slate-600 px-6 py-3 rounded-lg hover:bg-slate-800 transition">Cancelar</a>
    </div>
</form>
