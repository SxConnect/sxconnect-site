# ============================================
# SxConnect CMS - Workspace XPanel
# ============================================
# Preencher com os dados do ambiente na VPS
# Usar ao criar o workspace no XPanel
# ============================================

# --- DADOS DO PROJETO ---
PROJECT_NAME=sxconnect-cms
PROJECT_DOMAIN=sxconnect.com.br
PROJECT_ALIAS=www.sxconnect.com.br

# --- BANCO DE DADOS (MariaDB) ---
DB_IMAGE=mariadb:11
DB_CONTAINER_NAME=sxconnect-cms-db
DB_DATABASE=sxconnect_cms
DB_USER=sxconnect
DB_PASSWORD=sxconnect_secret
DB_ROOT_PASSWORD=5WCznp6ofiV1
DB_VOLUME_NAME=sxconnect-cms-db-data

# --- APP (Node.js) ---
APP_IMAGE=sxconnect-cms:latest
APP_CONTAINER_NAME=sxconnect-cms-app
APP_PORT=3000
APP_VOLUME_NAME=sxconnect-cms-uploads

# --- VARIAVEIS DE AMBIENTE DO APP ---
# (mesmas do .env do projeto)
APP_DB_HOST=sxconnect-cms-db
APP_DB_PORT=3306
APP_DB_USER=sxconnect
APP_DB_PASSWORD=sxconnect_secret
APP_DB_NAME=sxconnect_cms
APP_SESSION_SECRET=sxconnect_super_secret_key_change_in_production
APP_ADMIN_EMAIL=admin@sxconnect.com.br
APP_ADMIN_PASSWORD=Admin@123

# --- TRAEFIK (proxy reverso) ---
TRAEFIK_ENABLE=true
TRAEFIK_SERVICE_NAME=sxconnect-cms
TRAEFIK_ROUTER_RULE=Host(`sxconnect.com.br`) || Host(`www.sxconnect.com.br`)
TRAEFIK_CERT_RESOLVER=letsencryptresolver

# --- REDE ---
NETWORK_NAME=networko
NETWORK_DRIVER=overlay

# --- REPLICAS ---
DB_REPLICAS=1
APP_REPLICAS=1

# --- RESTART POLICY ---
RESTART_CONDITION=on-failure
RESTART_DELAY=5s
RESTART_MAX_ATTEMPTS=3

# --- BUILD (opcional - se for buildar na VPS) ---
BUILD_CONTEXT=./cms
BUILD_DOCKERFILE=./cms/Dockerfile
