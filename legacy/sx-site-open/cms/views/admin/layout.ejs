<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title + ' | Admin SxConnect' : 'Admin SxConnect' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; }
        .sidebar-link { transition: all 0.2s; }
        .sidebar-link:hover { background: rgba(59, 130, 246, 0.15); color: #60a5fa; }
        .sidebar-link.active { background: rgba(59, 130, 246, 0.2); color: #60a5fa; border-right: 3px solid #3b82f6; }
        .card { background: #1e293b; border-radius: 12px; border: 1px solid #334155; }
    </style>
</head>
<body>
    <div class="flex h-screen overflow-hidden">
        <aside class="w-64 bg-slate-900 border-r border-slate-800 flex-shrink-0 overflow-y-auto">
            <div class="p-6"><a href="/admin" class="text-2xl font-extrabold no-underline text-white">SX<span class="text-blue-500">CMS</span></a></div>
            <nav class="px-4 space-y-1">
                <a href="/admin" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath === '/admin' ? 'active' : '' %>">Dashboard</a>
                <a href="/admin/pages" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/pages') ? 'active' : '' %>">Paginas</a>
                <a href="/admin/sections" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/sections') ? 'active' : '' %>">Seccoes da Home</a>
                <a href="/admin/posts" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/posts') ? 'active' : '' %>">Noticias/Blog</a>
                <a href="/admin/categories" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>">Categorias</a>
                <a href="/admin/solutions" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/solutions') ? 'active' : '' %>">Solucoes</a>
                <a href="/admin/menus" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/menus') ? 'active' : '' %>">Menu</a>
                <a href="/admin/settings" class="sidebar-link block px-4 py-3 rounded-lg <%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">Configuracoes</a>
                <hr class="border-slate-800 my-4" />
                <a href="/" target="_blank" class="sidebar-link block px-4 py-3 rounded-lg">Ver Site &rarr;</a>
                <a href="/admin/logout" class="sidebar-link block px-4 py-3 rounded-lg text-red-400 hover:text-red-300">Sair</a>
            </nav>
        </aside>
        <main class="flex-1 overflow-y-auto p-8">
            <% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
                <% success_msg.forEach(function(msg) { %>
                    <div class="bg-green-900/50 border border-green-700 text-green-300 px-6 py-4 rounded-lg mb-4"><%= msg %></div>
                <% }); %>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
                <% error_msg.forEach(function(msg) { %>
                    <div class="bg-red-900/50 border border-red-700 text-red-300 px-6 py-4 rounded-lg mb-4"><%= msg %></div>
                <% }); %>
            <% } %>
            <%- body %>
        </main>
    </div>
</body>
</html>
