<%- include('../layout') %>
<div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Solucoes</h1>
    <a href="/admin/solutions/create" class="bg-blue-600 hover:bg-blue-700 px-5 py-2 rounded-lg font-semibold transition">+ Nova Solucao</a>
</div>
<% if (solutions.length === 0) { %><p class="text-slate-400">Nenhuma solucao cadastrada.</p><% } %>
<div class="space-y-3">
<% solutions.forEach(function(s) { %>
    <div class="card p-4 flex justify-between items-center">
        <div>
            <strong><%= s.title %></strong>
            <p class="text-sm text-slate-400"><%= s.subtitle %></p>
            <span class="text-xs text-slate-500">Ordem: <%= s.display_order %></span>
            <% if (!s.published) { %><span class="text-xs bg-yellow-600/20 text-yellow-400 px-2 py-0.5 rounded ml-2">Rascunho</span><% } %>
        </div>
        <div class="flex gap-2">
            <a href="/admin/solutions/<%= s.id %>/edit" class="text-blue-400 hover:underline text-sm">Editar</a>
            <form action="/admin/solutions/<%= s.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Excluir?')">
                <button type="submit" class="text-red-400 hover:underline text-sm">Excluir</button>
            </form>
        </div>
    </div>
<% }); %>
</div>
