<%- include('../layout') %>
<h1 class="text-3xl font-bold mb-8"><%= solution ? 'Editar' : 'Nova' %> Solucao</h1>
<form action="<%= solution ? '/admin/solutions/' + solution.id + '?_method=PUT' : '/admin/solutions' %>" method="POST" class="space-y-6 max-w-4xl">
    <div class="grid grid-cols-2 gap-6">
        <div><label class="block text-sm text-slate-400 mb-2">Titulo</label><input type="text" name="title" value="<%= solution ? solution.title : '' %>" required class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
        <div><label class="block text-sm text-slate-400 mb-2">Ordem</label><input type="number" name="display_order" value="<%= solution ? solution.display_order : 0 %>" min="0" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    </div>
    <div><label class="block text-sm text-slate-400 mb-2">Subtitulo</label><input type="text" name="subtitle" value="<%= solution ? solution.subtitle : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    <div><label class="block text-sm text-slate-400 mb-2">Descricao</label><textarea name="description" rows="5" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white"><%= solution ? solution.description : '' %></textarea></div>
    <div class="grid grid-cols-2 gap-6">
        <div><label class="block text-sm text-slate-400 mb-2">Texto do CTA</label><input type="text" name="cta_text" value="<%= solution ? solution.cta_text : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
        <div><label class="block text-sm text-slate-400 mb-2">Link do CTA</label><input type="text" name="cta_link" value="<%= solution ? solution.cta_link : '' %>" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 focus:outline-none focus:border-blue-500 text-white" /></div>
    </div>
    <div><label class="block text-sm text-slate-400 mb-2">Funcionalidades (uma por linha)</label><textarea name="features_str" rows="6" class="w-full bg-slate-900 border border-slate-600 rounded-lg px-4 py-3 font-mono text-sm focus:outline-none focus:border-blue-500 text-white"><%= solution && solution.features ? solution.features.join('\n') : '' %></textarea></div>
    <label class="flex items-center gap-3"><input type="checkbox" name="published" value="1" <%= !solution || solution.published ? 'checked' : '' %> class="w-5 h-5" /> <span>Publicado</span></label>
    <div class="flex gap-4">
        <button type="submit" class="bg-blue-600 hover:bg-blue-700 px-6 py-3 rounded-lg font-semibold transition">Salvar</button>
        <a href="/admin/solutions" class="border border-slate-600 px-6 py-3 rounded-lg hover:bg-slate-800 transition">Cancelar</a>
    </div>
</form>
